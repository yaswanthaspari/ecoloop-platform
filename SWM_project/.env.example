# EcoLoop Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env to source control.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecoloop

# Uploads
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH_MB=10

# AI Classifier
MODEL_PATH=instance/models/ecoloop_classifier.h5
MODEL_VERSION=1.0.0
CONFIDENCE_THRESHOLD=0.60

# Admin bootstrap (used by seed script only)
ADMIN_EMAIL=admin@ecoloop.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=EcoLoop Admin
